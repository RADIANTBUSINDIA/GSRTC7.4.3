<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xLinLayHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- TOP BAR -->

    <RelativeLayout
        android:id="@+id/xRellayTop"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/height_for_top_bar_home"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/xTvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:text="Transaction Status"
            android:textColor="@color/naviy"
            android:textStyle="bold"
            android:textSize="25dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/xTvHeader"
            android:background="@color/naviy"/>

    </RelativeLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
            android:id="@+id/text_view_new"
            android:text="Payment Status!"
            android:textSize="22dp"
            android:textColor="@color/naviy"
            android:paddingBottom="10dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textStyle="bold"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"  />


        <LinearLayout
            android:id="@+id/xLinLay1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:layout_marginBottom="140dp"
            android:orientation="horizontal" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="cancelled By User"
                android:textColor="@color/bpRed"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_marginLeft="10dp"
                android:id="@+id/text_view_one"/>
        </LinearLayout>

        <Button
            android:id="@+id/butto"
            android:layout_width="250dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            style="@style/Gsrtc_Button_orangeBtn"
            android:gravity="center"
            android:text="HOME"
            android:layout_marginBottom="20dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:textSize="18dp" />

    </LinearLayout>

</RelativeLayout>
