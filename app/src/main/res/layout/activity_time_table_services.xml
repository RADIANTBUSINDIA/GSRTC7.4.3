<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_img"
    android:id="@+id/rootView"
    tools:context="com.gsrtc.mobileweb.ui.activities.advance_booking.AdvanceBookingSearchActivity">

    <RelativeLayout
        android:id="@+id/xRellayTop"
        android:layout_width="fill_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        >

        <TextView
            android:id="@+id/header_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AHMEDABAD KRISHNANAGAR STAND  to  ADIPUR 06/04/2017"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14dp"
            android:gravity="center"
            android:padding="2dp"/>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="5dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_calender"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:orientation="horizontal">
        </androidx.recyclerview.widget.RecyclerView>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/advance_booking_list_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white">
            <TextView
                android:id="@+id/onRouteBook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OnRoute Booking"
                android:textStyle="bold"
                android:visibility="gone"
                android:background="@color/blue"
                android:textSize="15dp"
                android:layout_margin="2dp"
                android:textColor="@color/white"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/onroute_list"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@color/white"
                android:paddingBottom="2dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_results_onroute_view"
                    android:visibility="gone"
                    android:background="@drawable/advance_booking_list_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </androidx.recyclerview.widget.RecyclerView>

            </LinearLayout>

            <TextView
                android:id="@+id/advBook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advance Booking"
                android:textStyle="bold"
                android:visibility="gone"
                android:textSize="15dp"
                android:background="@color/blue"
                android:layout_margin="2dp"
                android:textColor="@color/white"
                android:gravity="center"/>
            <!--<android.support.v4.widget.SwipeRefreshLayout-->
            <!--xmlns:android="http://schemas.android.com/apk/res/android"-->
            <!--android:id="@+id/swipeContainer"-->
            <!--android:layout_width="match_parent"-->
            <!--android:paddingLeft="6dp"-->
            <!--android:paddingRight="6dp"-->
            <!--android:layout_height="wrap_content">-->
            <LinearLayout
                android:id="@+id/adv_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/white">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_results_recycler_view"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                </androidx.recyclerview.widget.RecyclerView>
                <LinearLayout
                    android:id="@+id/search_results_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@color/white"
                    android:orientation="vertical">
                </LinearLayout>
            </LinearLayout>

            <!--</android.support.v4.widget.SwipeRefreshLayout>-->
        </LinearLayout>
    </ScrollView>

</LinearLayout>
