<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:orientation="vertical"
    android:background="@drawable/search_input_text_navi_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/pnrtxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PNR No  :-"
            android:textStyle="bold"
            android:textSize="15dp"/>
        <TextView
            android:id="@+id/pnr"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GS2345234"
            android:textSize="15dp"
            android:textColor="@color/bpRed"
            android:textStyle="bold"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tripcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TripCode  :-"
            android:textStyle="bold"
            android:textSize="15dp"/>
        <TextView
            android:id="@+id/tripco"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GS2345234"
            android:textSize="15dp"
            android:textColor="@color/bpRed"
            android:textStyle="bold"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/journey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Journey Date  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/journey_date"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18/03/2019"

            android:textColor="@color/black"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/transdatetxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction Date  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/trans_date"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18/03/2019"

            android:textColor="@color/black"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/serv_clstxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service Class  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/serv_cls"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18/03/2019"

            android:textColor="@color/black"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/from_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From Place  :-"
            android:textStyle="bold"
            android:textSize="15dp"/>
        <TextView
            android:id="@+id/from"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SURAT CENTRAL BUS STAND "
            android:textColor="@color/black" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/to_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="To Place  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/to"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AHMEDABAD CENTRAL BUS STAND"
            android:textColor="@color/black"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/pickupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PickUp Point  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/pickName"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AHMDSRT1915"
            android:textColor="@color/black" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/pickupTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PickUp Time  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/pickTime"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1541"
            android:textColor="@color/black" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/droppoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drop Off Point  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/dropName"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1541"
            android:textColor="@color/black" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/seat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seat No(s)  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/SeatNo"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1541"
            android:textColor="@color/black" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/adult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adult(s) Count  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/adult_count"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1541"
            android:textColor="@color/black" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/child"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Child(s) Count  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/child_count"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1541"
            android:textColor="@color/black" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/fare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Fare  :-"
            android:textSize="15dp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/total_fare"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1541"
            android:textColor="@color/black" />

    </LinearLayout>

</LinearLayout>
