<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/common_layout"
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_margin="10dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/bus_station"
                android:text="HIMATNAGAR-SURAT CENTRAL BUS STAND"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <com.gsrtc.mobileweb.ui.widgets.AccordionWidget
                android:id="@+id/travel_details_accordion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:accordion_heading="Travel Details"
                app:accordion_expand_layout="@+id/route_details_content"
                app:accordion_layout="route_details"
                android:layout_margin="6dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">
                <TextView
                    android:text="BUS NO:"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/bus_no"
                    android:text="GJ-18-Z-2431-[ GURJARNAGRI ] [DEP: 12:45 ]"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">
                <TextView
                    android:text="DEPARTED:"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/departed"
                    android:text="N/A, N/A"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">
                <TextView
                    android:text="N/A"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <Button
                android:text="BOOK INR 98"
                android:layout_gravity="right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Gsrtc_Button_orangeBtn"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
               />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>