<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_img"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".ui.activities.track_mybus_native.TrackonRoutes">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GSRTC Vehicles On Route (Round Trips) "
                android:textSize="16dp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp"
                android:textColor="@color/white"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/title_subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tripsheet Generated in Last 4 Hrs"
                android:textColor="@color/white"
                android:layout_marginBottom="5dp"
                android:textSize="14dp"
                android:textStyle="normal"
                android:gravity="center"/>

            <View
                android:id="@+id/second"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/top"
                android:layout_marginBottom="15dp"
                android:background="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Source"
                    android:textStyle="normal"
                    android:textColor="@color/white"/>

                <AutoCompleteTextView
                    android:id="@+id/source"
                    android:theme="@style/EditTextStyle"
                    android:layout_marginBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="From"
                    android:textColorHint="@color/hint"
                    android:textColor="@color/white"
                    android:drawableStart="@drawable/location_img"
                    android:drawablePadding="10dp"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/swap"
                    android:id="@+id/swap"
                    android:layout_alignBottom="@+id/to_location" />

                <TextView
                    android:id="@+id/txt_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Destination"
                    android:textColor="@color/white"/>

                <AutoCompleteTextView
                    android:id="@+id/destination"
                   android:theme="@style/EditTextStyle"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="20dp"
                    android:layout_height="45dp"
                    android:textColorHint="@color/hint"
                    android:textColor="@color/white"
                    android:drawableStart="@drawable/location_img"
                    android:drawablePadding="10dp"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:hint="To"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/search"
                android:background="@drawable/btn_shape"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:text="Search"
                android:textStyle="bold"
                android:textColor="@color/naviy" />

            <TextView
                android:id="@+id/txt_note"
                android:text="Note : Result may take couple of minutes."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_marginTop="30dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

