<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_img"
    tools:context="com.gsrtc.mobileweb.ui.activities.booking_history.BookingHistoryActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Title -->
            <TextView
                android:id="@+id/title_book_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction History"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="15dp"
                android:background="@color/white" />

            <!-- Email -->
            <TextView
                android:id="@+id/email_txt"
                android:text="Email ID *"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Email ID"
                android:singleLine="true"
                android:theme="@style/EditTextStyle"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                android:drawableStart="@drawable/mail"
                android:drawablePadding="10dp" />

            <!-- Mobile -->
            <TextView
                android:id="@+id/mobile_txt"
                android:text="Mobile Number *"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_marginTop="10dp" />

            <EditText
                android:id="@+id/mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Mobile Number"
                android:inputType="number"
                android:digits="0123456789"
                android:maxLength="10"
                android:singleLine="true"
                android:theme="@style/EditTextStyle"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="10dp" />

            <!-- Date -->
            <TextView
                android:id="@+id/date_txt"
                android:text="Date *"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <EditText
                    android:id="@+id/from_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="From Date"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:theme="@style/EditTextStyle"
                    android:textColor="@color/white"
                    android:textColorHint="@color/hint"
                    android:drawableStart="@drawable/date_img"
                    android:drawablePadding="10dp"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/to_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="To Date"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:theme="@style/EditTextStyle"
                    android:textColor="@color/white"
                    android:textColorHint="@color/hint"
                    android:drawableStart="@drawable/date_img"
                    android:drawablePadding="10dp" />
            </LinearLayout>

            <!-- Status -->
            <TextView
                android:id="@+id/status_txt"
                android:text="Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_marginTop="10dp" />

            <Spinner
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/transaction_history_status"
                android:layout_marginBottom="20dp"
                android:theme="@style/AppTheme.spinnerDropDownItemStyle" />

            <!-- Submit -->
            <Button
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:textColor="@color/naviy"
                android:background="@drawable/btn_shape"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
