<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="1"
    android:background="@drawable/background_img"
    android:id="@+id/container"
    tools:context=".ui.activities.time_table.Timetable_Search">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:paddingTop="10dp"
            android:id="@+id/time_table_title"
            android:gravity="center"
            android:textStyle="bold"
            android:text="Time Table"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/title"
            android:id="@+id/second"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="15dp"
            android:background="@color/white"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/tripbtn"
            android:background="@drawable/border"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/advance_txt"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:text="Express Trip"
                    android:background="@drawable/btn_shape"
                    android:gravity="center"
                    android:textColor="@color/black" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_below="@+id/tripbtn">
                <TextView
                    android:id="@+id/local_txt"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:text="(β)   Local Trip"
                    android:textColor="@color/white"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/search_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:background="#EEE"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:gravity="center"
                    android:layout_marginBottom="25dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/local_trip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:textSize="20dp"
                        android:layout_weight="1"
                        android:textColor="@color/naviy"
                        android:text="Local Trip"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="visible" />

                    <RadioButton
                        android:id="@+id/advance_trip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Advance Trip"
                        android:textStyle="bold"
                        android:textColor="@color/naviy"
                        android:textSize="20dp"
                        android:layout_weight="1"
                        android:visibility="visible"
                        android:clickable="true"
                        android:gravity="center"
                        android:checked="false"/>

                </RadioGroup>

                <AutoCompleteTextView
                    android:id="@+id/from_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginBottom="20dp"
                    android:hint="From"
                    android:drawableStart="@drawable/location_img"
                    android:inputType="textEmailAddress"
                    android:drawablePadding="10dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/hint"
                    android:theme="@style/EditTextStyle" />

                <AutoCompleteTextView
                    android:id="@+id/to_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/from_location"
                    android:layout_marginBottom="20dp"
                    android:hint="To"
                    android:drawableStart="@drawable/location_img"
                   android:drawablePadding="10dp"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white"
                    android:textColorHint="@color/hint"
                    android:theme="@style/EditTextStyle" />

                <ImageView
                    android:id="@+id/swap"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignBottom="@+id/to_location"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="clip_vertical"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="18dp"
                    android:src="@drawable/swap" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/to_location"
                    android:weightSum="1"
                    android:background="#E5E2E3"
                    android:id="@+id/sum"
                    android:visibility="gone"
                    android:orientation="horizontal">
                    <Spinner
                        android:id="@+id/serv_cls"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="@color/black"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_marginBottom="20dp"
                        android:layout_marginRight="6dp"
                        android:layout_weight="1"/>
                    <!--<Spinner-->
                    <!--android:id="@+id/serv_time"-->
                    <!--android:layout_width="match_parent"-->
                    <!--android:layout_height="match_parent"-->
                    <!--android:hint="Return"-->
                    <!--android:textColor="@color/black"-->
                    <!--android:focusable="false"-->
                    <!--android:focusableInTouchMode="false"-->
                    <!--android:layout_marginBottom="10dp"-->
                    <!--android:layout_weight="1"/>-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1"
                    android:id="@+id/sum_three"
                    android:paddingTop="15dp"
                    android:orientation="horizontal"
                    android:layout_below="@+id/sum"
                    android:layout_marginBottom="10dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true">
                    <EditText
                        android:id="@+id/journey_date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Journey Date"
                        android:textColor="@color/white"
                        android:textColorHint="@color/hint"
                        android:theme="@style/EditTextStyle"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_marginRight="10dp"
                        android:drawableStart="@drawable/date_img"
                        android:layout_marginBottom="10dp"
                        android:drawablePadding="10dp"
                        android:layout_weight="1"/>
                </LinearLayout>

                <Button
                    android:id="@+id/search_btn"
                    android:layout_width="match_parent"
                    android:background="@drawable/btn_shape"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/sum_three"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="50dp"
                    android:text="SEARCH"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/layout_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="20dp"
                android:layout_marginBottom="30dp"
                android:orientation="vertical">

            </LinearLayout>


            <LinearLayout
                android:id="@+id/loading_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/no_internet_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="No Internet. Click to try Again"
                    android:textColor="@color/bpRed"
                    android:textSize="18sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
