<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="3dp"
    android:paddingRight="3dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:background="#EEE">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/xRellayTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="2dp"
            android:background="#DFFF00"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">

            <TextView
                android:id="@+id/booking_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_weight="1"
                android:text="SLEEPER"/>
            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                android:text="INR 200"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:gravity="right" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/xRellayMiddle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_below="@+id/xRellayTop">
            <TextView
                android:id="@+id/bus_route"
                android:text="Ahmedabad central bus stand to mehasna central busstand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:textColor="#DB0000" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/xRellayLast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_below="@+id/xRellayMiddle">

            <TextView
                android:id="@+id/departure_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:singleLine="true"
                android:text="DepTime : 08:30:00"
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="#000080" />

            <!--<ImageView-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:src="@drawable/round_two"-->
                <!--android:id="@+id/imageView2"-->
                <!--android:layout_alignBottom="@+id/journey_hours"-->
                <!--android:layout_toRightOf="@+id/departure_time"-->
                <!--android:layout_toEndOf="@+id/departure_time"-->
                <!--android:layout_marginLeft="10dp"/>-->

            <TextView
                android:id="@+id/journey_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="23dp"
                android:layout_marginRight="23dp"
                android:text="Jrny.Hrs : 5hrs 30min"
                android:textColor="#000080"
                android:textSize="14dp" />

            <!--<ImageView-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:src="@drawable/round_one"-->
                <!--android:id="@+id/imageView7"-->
                <!--android:layout_marginLeft="15dp"-->
                <!--android:layout_marginStart="15dp"-->
                <!--android:layout_alignBottom="@+id/journey_hours"-->
                <!--android:layout_toRightOf="@+id/journey_hours"-->
                <!--android:layout_toEndOf="@+id/journey_hours" />-->

            <TextView
                android:id="@+id/arrival_time"
                android:text="21:30:00"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="11dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginStart="15dp"
                android:layout_alignParentTop="true"
                android:layout_toRightOf="@+id/imageView7"
                android:layout_toEndOf="@+id/imageView7" />

            <TextView
                android:id="@+id/no_seats"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:text="30 seats"
                android:textStyle="bold"
                android:textSize="15dp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/xRellayfinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_below="@+id/xRellayMiddle">

            <TextView
                android:id="@+id/trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="Tripcode  : "
                android:textSize="12dp"/>

            <TextView
                android:id="@+id/tripcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/trip"
                android:layout_toRightOf="@+id/trip"
                android:text="1200ABDSRTEXP41"
                android:textColor="@color/black"
                android:textStyle="normal"
                android:textSize="12dp"/>

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/xRellayfinal_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_below="@+id/xRellayMiddle">

            <TextView
                android:id="@+id/depot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:textColor="@color/black"
                android:text="DepotName  : "
                android:textSize="12dp"/>

            <TextView
                android:id="@+id/depot_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/depot"
                android:layout_toRightOf="@+id/depot"
                android:text="ahmedabad"
                android:textColor="@color/black"
                android:textStyle="normal"
                android:textSize="12dp"/>

        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>