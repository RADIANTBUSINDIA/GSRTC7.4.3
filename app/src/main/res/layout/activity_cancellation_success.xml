<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="@drawable/background_img"
tools:context="com.gsrtc.mobileweb.ui.activities.ticket_cancellation.CancellationSuccessActivity">
<TextView
    android:id="@+id/header_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Cancellation Status"
    android:textColor="@color/white"
    android:fontFamily="@font/gotham"
    android:textStyle="bold"
    android:gravity="center"
    android:padding="8dp"/>

<LinearLayout
    android:orientation="vertical"
    android:layout_margin="10dp"
    android:padding="8dp"
    android:background="@drawable/btn_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/cancelmsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:padding="10dp"
        android:text="The Ticket has been Cancelled. \nThe amount shall be refunded to your Account within 7 working days."/>
</LinearLayout>
    <Button
        android:id="@+id/submitBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Home"
        android:textStyle="bold"
        android:textColor="@color/naviy"
        android:layout_margin="30dp"
        android:background="@drawable/btn_shape"/>
</LinearLayout>
