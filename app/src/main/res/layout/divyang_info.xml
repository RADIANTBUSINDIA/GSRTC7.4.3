<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/divyang_dialog_card_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Divyang Verification"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Enter Divyang ID and OTP to proceed"
            android:textColor="#666666"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#E2E8F0" />

        <!-- 1. Divyang ID Field (ENTERABLE) -->
        <TextView
            android:id="@+id/div_id_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="Divyang ID / Card Number"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/div_id"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/divyang_input_bg"
                android:hint="Enter Divyang ID"
                android:inputType="text|number"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#0F172A"
                android:textSize="15sp" />

            <Button
                android:id="@+id/div_send_otp_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/btn_divyang_otp"
                android:minWidth="95dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="GET OTP"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OTP Status Message -->
        <TextView
            android:id="@+id/div_status_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#16A34A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 2. Divyang Information Card (SHOWN on entering Divyang ID / fetching OTP) -->
        <LinearLayout
            android:id="@+id/div_details_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/divyang_info_card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Divyang Card Details"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/div_verified_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/divyang_badge_bg"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="VERIFIED"
                    android:textColor="#15803D"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#E2E8F0" />

            <!-- Cardholder Name -->
            <LinearLayout
                android:id="@+id/div_name_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Name:"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/div_name_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DIVYANG PASSENGER"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Disability Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Disability:"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/div_disability_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MORE THAN 80% BLIND"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Concession Rate & DOB Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <!-- Concession -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Concession: "
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/div_percent_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#16A34A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- DOB -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOB: "
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/div_dob_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01/01/1990"
                        android:textColor="#0F172A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Authority & Expiry Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Authority -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Authority: "
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/div_authority_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DSWO AHMEDABAD"
                        android:textColor="#0F172A"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Valid Upto -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Valid Upto: "
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/div_expired_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01/01/2030"
                        android:textColor="#0F172A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Verification OTP (ENTERABLE) -->
        <TextView
            android:id="@+id/div_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="5dp"
            android:text="Enter Verification OTP"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/div_otpNumber"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/divyang_input_bg"
            android:gravity="center"
            android:hint="Enter 6-digit OTP"
            android:inputType="number"
            android:letterSpacing="0.1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="#0F172A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/div_otp_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Enter the OTP received on registered mobile number."
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- 4. Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/div_cancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_divyang_secondary"
                android:text="CANCEL"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/div_submit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:background="@drawable/btn_divyang_primary"
                android:text="VERIFY &amp; SUBMIT"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hidden legacy views for complete zero-breakage compatibility -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView android:id="@+id/div_type_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <EditText android:id="@+id/div_type" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/div_disablity_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/div_disablity" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/div_percent_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <EditText android:id="@+id/div_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/div_authority_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/div_authority" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/div_dob_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <EditText android:id="@+id/div_dob" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/div_expired_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <EditText android:id="@+id/div_expired" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>