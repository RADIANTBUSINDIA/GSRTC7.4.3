<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:background="@drawable/div_info">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="1dp"
        android:padding="5dp"
        android:gravity="center"
        android:background="@color/white"
        android:textColor="@color/naviy"
        android:textStyle="bold"
        android:fontFamily="@font/gotham"
        android:text="Divyang Information"
        android:textSize="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dip"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="3dp">

            <TextView
                android:id="@+id/div_id_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:text="Divyang Id"
                android:textColor="@color/white"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/div_id"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:hint="Divyang Id"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:theme="@style/EditTextStyle"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/div_type_txt"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:text="Divyang Type"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/div_type"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:editable="false"
                android:focusable="false"
                android:hint="Divyang Type"
                android:textColor="@color/white"
                android:theme="@style/EditTextStyle"
                android:inputType="textEmailAddress" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dip"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/div_disablity_txt"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:text="Types of Disablity"
                android:textSize="16dp" />

            <Spinner
                android:id="@+id/div_disablity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:theme="@style/AppTheme.spinnerDropDownItemStyle"
                tools:ignore="SpeakableTextPresentCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/div_percent_txt"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:text="Percentage of Disablity"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/div_percent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:editable="false"
                android:focusable="false"
                android:hint="Percentage of Disablity"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:theme="@style/EditTextStyle"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dip"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/div_authority_txt"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:text="Authority Details"
                android:textSize="16dp" />

            <Spinner
                android:id="@+id/div_authority"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:theme="@style/AppTheme.spinnerDropDownItemStyle"
                android:layout_marginTop="3dp"
                tools:ignore="SpeakableTextPresentCheck" />

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dip"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/div_dob_txt"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:text="Date of Birth"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/div_dob"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:editable="false"
                android:focusable="false"
                android:hint="Date of Birth"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:theme="@style/EditTextStyle"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:id="@+id/div_expired_txt"
                android:paddingLeft="1dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:text="Expired Date"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/div_expired"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:editable="false"
                android:focusable="false"
                android:hint="Expired Date"
                android:textColor="@color/white"
                android:theme="@style/EditTextStyle"
                android:inputType="textEmailAddress" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dip"
        android:layout_weight="1"
        android:padding="5dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:paddingLeft="3dp">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/btn_shape"
            android:id="@+id/div_submit"
            android:paddingLeft="1dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:layout_gravity="right"
            android:gravity="center"
            android:textStyle="bold"
            android:padding="10dp"
            android:textColor="#008000"
            android:text="SUBMIT"
            android:textSize="20dp" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:id="@+id/div_cancel"
            android:paddingLeft="1dp"
            android:padding="10dp"
            android:layout_margin="3dp"
            android:background="@drawable/btn_shape"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_gravity="right"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/bpRed"
            android:text="CANCEL"
            android:textSize="20dp" />

    </LinearLayout>

</LinearLayout>