<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_img"
    android:padding="16dp"
    tools:context="com.gsrtc.mobileweb.ui.activities.Help_SupportActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:textStyle="bold"
                android:fontFamily="@font/gotham"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"
                android:text="Help and Support"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/top"
                android:id="@+id/second"
                android:layout_marginBottom="10dp"
                android:background="@color/white"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">
                <TextView
                    android:id="@+id/helpnumtxt"
                    android:text="Helpline Number    : "
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/helplineno"
                    android:text=" 1800233666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColorLink="#e65100"
                    android:textColor="#e65100"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:autoLink="phone"
                    android:linksClickable="true"
                    />
            </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:orientation="horizontal"
                    >
            <TextView
                  android:id="@+id/txtrefund"
                  android:text="Refund Complaint :  "
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="@color/white"
                  android:textSize="18dp"/>
            <TextView
                android:id="@+id/helplineemail"
                android:text="Click here!"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColorLink="#e65100"
                android:textColor="#e65100"
                android:textSize="20dp"
                android:linksClickable="true"/>
            </LinearLayout>
        </LinearLayout>
</LinearLayout>




