<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@drawable/border">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="10dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        app:contentPadding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

    <TextView
        android:id="@+id/bookedOn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9b2424"
        android:layout_marginBottom="10dp"
        android:text="Booked On - 12/05/207" />
    <TextView
        android:id="@+id/place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AHMEDABAD CENTRAL BUSSTAND - SURAT" />
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status - CNF" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Journey Date - 14/05/207" />
        <TextView
            android:id="@+id/fare"
            android:paddingLeft="120dp"
            android:layout_width="wrap_content"
            android:textColor="#9b2424"
            android:layout_height="wrap_content"
            android:text="INR 99" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/pnr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pnr" />
        <TextView
            android:id="@+id/trip_code"
            android:paddingLeft="30dp"
            android:textStyle="bold"
            android:textColor="@color/blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trip Code" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/obrefno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pnr" />
        <TextView
            android:id="@+id/mobleno"
            android:paddingLeft="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trip Code" />

       </LinearLayout>
    </LinearLayout>
 </androidx.cardview.widget.CardView>

</LinearLayout>
