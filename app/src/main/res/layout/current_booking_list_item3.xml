<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="10dp"
    android:orientation="vertical">
    <TextView
        android:id="@+id/li_FromToPlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="#000000"
        android:text="FROM-TO"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        style="@style/Gsrtc_listitem_route_details"
        android:id="@+id/linearLayoutRouteDetails">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/li_RouteDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route Details"
                android:textStyle="bold"
                android:layout_weight="1"
                />

            <TextView
                android:id="@+id/li_RouteDetails_Expand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+"
                android:textStyle="bold"
                android:layout_weight="1"
                android:gravity="right"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Large"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"></LinearLayout>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/bus_NO_Heading"
            android:layout_below="@id/booking_class"
            android:textStyle="bold"
            android:text="Bus Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/bus_NO_Text"
            android:layout_below="@id/bus_route"
            android:textStyle="bold"
            android:text="GJ-18-Y-0017"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/departed_Heading"
            android:layout_below="@id/booking_class"
            android:textStyle="bold"
            android:text="Departed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/departed_Text"
            android:layout_below="@id/bus_route"
            android:textStyle="bold"
            android:text="GJ-18-Y-0017"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/seatavailable_Heading"
            android:layout_below="@id/booking_class"
            android:textStyle="bold"
            android:text="Seats Available"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/seatavailable_Heading_Text"
            android:layout_below="@id/bus_route"
            android:textStyle="bold"
            android:text="GJ-18-Y-0017"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/bus_running_status"
            android:layout_below="@id/booking_class"
            android:textStyle="bold"
            android:text="Vehicle Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/bus_running_status_Text"
            android:layout_below="@id/bus_route"
            android:textStyle="bold"
            android:text="GJ-18-Y-0017"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <!--<TextView
        android:id="@+id/bus_running_status"
        android:textStyle="bold"
        android:text="On Time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#008000"/>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/li_book_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Gsrtc_Button_orangeBtn"
            android:text="@string/Rs"
            android:layout_weight="0.1"
            />

    </LinearLayout>


    <TextView
        android:id="@+id/bus_footer"
        android:text="*Under Current Booking seats are not assured. Its First Come First Serve Basis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />



</LinearLayout>